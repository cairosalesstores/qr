<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cairosales.qr.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/gad/Desktop/inventoryQR/.venv/bin/python</string>
    <string>/Users/gad/Desktop/inventoryQR/nightly.py</string>
    <string>--publish</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/gad/Desktop/inventoryQR</string>
  <!-- Two chances a day: overnight, and midday when the Mac is certainly awake.
       The job itself skips the second run if the first already succeeded. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/gad/Desktop/inventoryQR/data/runs/nightly.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gad/Desktop/inventoryQR/data/runs/nightly.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
