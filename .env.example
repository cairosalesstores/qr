# Cairo Sales QR — Supabase connection
# Copy this file to ".env" (that copy is git-ignored) and paste the values from:
#   Supabase dashboard → your project → Settings → API Keys
# Never put a real key in THIS file — it is tracked by git.

# "Project URL"  (looks like https://abcdefghijkl.supabase.co)
SUPABASE_URL=

# Publishable key — safe in a browser
SUPABASE_ANON_KEY=

# Secret key — FULL ACCESS. Only the nightly job on this Mac uses it.
SUPABASE_SERVICE_KEY=
